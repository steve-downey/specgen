# packaging/release/images.env                                     -*-sh-*-
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
#
# The toolchain the release binary is built with: the `llvm` layer of
# ghcr.io/steve-downey/specgen-toolchain, by digest, as the toolchain-image
# workflow's summary prints it. The release-binary workflow reads this file,
# so moving to a new toolchain is a reviewed change to this line and nothing
# else. Plain `NAME=value` lines, so `.` in a shell and `docker run
# --env-file` both read it.
#
# 2026-10-14: gcc-toolset-16 16.2.1, LLVM 23.1.3 release archives.
SPECGEN_TOOLCHAIN_IMAGE=ghcr.io/steve-downey/specgen-toolchain@sha256:0b6d384ec34adfea6303910627d31693d764412ee5954303098a1bdfbf53da2c
